# PostgreSQL connection string (Supabase, Neon, Render, local…). Omit for an in-memory dev database.
DATABASE_URL=postgresql://user:password@host:5432/netlab
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of allowed front-end origins
CORS_ORIGIN=http://localhost:5173,https://your-netlab.vercel.app
PORT=8787
# Optional: promote this registered user to the admin role at start-up
ADMIN_EMAIL=
